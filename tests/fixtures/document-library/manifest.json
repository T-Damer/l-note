{
  "schemaVersion": 1,
  "kind": "lnote.document-acceptance",
  "corpusVersion": "2026.08.04.4",
  "cases": [
    {
      "id": "markdown-structure",
      "format": "markdown",
      "source": "tests/fixtures/document-library/structured.md",
      "status": "active",
      "expect": {
        "title": "Локальная медицинская библиотека",
        "minSections": 3,
        "contains": [
          "Инфекция мочевых путей",
          "| Температура | 37,5 °C |",
          "https://example.org/reference"
        ]
      }
    },
    {
      "id": "utf8-text",
      "format": "txt",
      "source": "tests/fixtures/document-library/plain.txt",
      "status": "active",
      "expect": {
        "minSections": 1,
        "contains": [
          "кириллицу",
          "125 мг",
          "0,5 г",
          "2026 год"
        ]
      }
    },
    {
      "id": "generated-docx-headings",
      "format": "docx",
      "source": "generated:minimal-headings.docx",
      "status": "active",
      "expect": {
        "title": "Локальный DOCX",
        "sectionTitles": ["Первый раздел", "Второй раздел"],
        "paragraphAnchors": [[3, 3], [5, 5]]
      }
    },
    {
      "id": "bundled-pdf-wasm",
      "format": "pdf",
      "source": "assets/lnote-source-demo.pdf",
      "status": "active",
      "expect": {
        "parserVersion": "0.1.3",
        "minPages": 1,
        "minMarkdownChars": 20,
        "requiresExplicitOcrRouting": true
      }
    },
    {
      "id": "generated-mixed-pdf",
      "format": "pdf-mixed",
      "source": "generated:mixed.pdf",
      "status": "active",
      "expect": {
        "pageCount": 2,
        "textPage": 1,
        "ocrPage": 2,
        "contains": "TEXT LAYER PAGE ONE"
      }
    },
    {
      "id": "generated-scanned-pdf-reviewed-ocr",
      "format": "pdf-scanned",
      "source": "generated:scan.pdf",
      "status": "active",
      "expect": {
        "pageCount": 1,
        "ocrPages": [1],
        "reviewedText": "Reviewed scanned page text."
      }
    },
    {
      "id": "generated-multicolumn-pdf",
      "format": "pdf-multicolumn",
      "source": "generated:columns.pdf",
      "status": "active",
      "expect": {
        "pageCount": 1,
        "tableRows": [
          ["LEFT COLUMN ALPHA", "RIGHT COLUMN ALPHA"],
          ["Left column sentence one.", "Right column sentence one."],
          ["Left column sentence two.", "Right column sentence two."],
          ["Left column sentence three.", "Right column sentence three."],
          ["LEFT COLUMN OMEGA", "RIGHT COLUMN OMEGA"]
        ]
      }
    },
    {
      "id": "generated-image-heavy-pdf",
      "format": "pdf-image-heavy",
      "source": "generated:image-heavy.pdf",
      "status": "active",
      "expect": {
        "pageCount": 1,
        "imageObjects": 4,
        "contains": "IMAGE HEAVY SEARCHABLE PAGE"
      }
    },
    {
      "id": "generated-long-document",
      "format": "markdown-long",
      "source": "generated:long-document.md",
      "status": "active",
      "expect": {
        "sections": 5200,
        "endMarker": "longdoc-5200",
        "searchMarkers": ["longdoc-0001", "longdoc-2600", "longdoc-5200"]
      }
    },
    {
      "id": "generated-embedded-type3-font",
      "format": "pdf-embedded-font",
      "source": "generated:embedded-font.pdf",
      "status": "active",
      "expect": {
        "contains": [
          "EMBEDDED FONT TEXT",
          "SEARCHABLE SOURCE TEXT REMAINS AVAILABLE",
          "ENCODING PROVENANCE MUST REMAIN EXPLICIT"
        ]
      }
    },
    {
      "id": "generated-broken-font-encoding",
      "format": "pdf-broken-encoding",
      "source": "generated:broken-font.pdf",
      "status": "active",
      "expect": {
        "ocrPages": [1]
      }
    }
  ],
  "coverage": [
    { "category": "markdown", "status": "active", "caseId": "markdown-structure" },
    { "category": "txt-utf8", "status": "active", "caseId": "utf8-text" },
    { "category": "docx-headings", "status": "active", "caseId": "generated-docx-headings" },
    { "category": "pdf-wasm", "status": "active", "caseId": "bundled-pdf-wasm" },
    { "category": "mixed-pdf", "status": "active", "caseId": "generated-mixed-pdf" },
    { "category": "scanned-pdf-reviewed-ocr", "status": "active", "caseId": "generated-scanned-pdf-reviewed-ocr" },
    { "category": "multi-column-pdf", "status": "active", "caseId": "generated-multicolumn-pdf" },
    { "category": "image-heavy-pdf", "status": "active", "caseId": "generated-image-heavy-pdf" },
    { "category": "long-document", "status": "active", "caseId": "generated-long-document" },
    { "category": "unusual-embedded-fonts", "status": "active", "caseId": "generated-embedded-type3-font" },
    { "category": "broken-font-encoding", "status": "active", "caseId": "generated-broken-font-encoding" }
  ]
}
