{
  "name": "l-note",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --config apps/web/vite.config.js",
    "build": "node scripts/verify-packs.mjs && vite build --config apps/web/vite.config.js",
    "preview": "vite preview --config apps/web/vite.config.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:source": "node scripts/check-source.mjs",
    "check:packs": "node scripts/verify-packs.mjs",
    "check": "npm run check:source && npm run check:packs && npm test && npm run build"
  },
  "dependencies": {
    "fuse.js": "7.5.0",
    "idb": "8.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
